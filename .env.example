# Copy to .env and replace every value. Do not commit .env.
POSTGRES_PASSWORD=change-me
FF_OWNER_PASSWORD=change-me
FF_APP_PASSWORD=change-me
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FF_JWT_SECRET=change-me-change-me-change-me-change-me

# --- Optional: email for password reset codes -------------------------------------------
# Without FF_SMTP_HOST, reset codes are written to the backend log instead of being emailed.
# For Gmail: host smtp.gmail.com, port 587, your address as the user, and an "app password".
#FF_SMTP_HOST=smtp.gmail.com
#FF_SMTP_PORT=587
#FF_SMTP_USER=you@example.com
#FF_SMTP_PASSWORD=app-password
#FF_SMTP_FROM=FreightFlow <you@example.com>

# --- Optional: a language model for the chatbot -----------------------------------------
# With a key, the model chooses which lookup answers a question; without one, built-in rules do.
# The model is sent the question, city names and the LR number being discussed. It is never
# sent LR records.
#FF_LLM_API_KEY=
#FF_LLM_MODEL=claude-haiku-5-5
