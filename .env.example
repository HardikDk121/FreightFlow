# Copy to .env and replace every value. Do not commit .env.
POSTGRES_PASSWORD=change-me
FF_OWNER_PASSWORD=change-me
FF_APP_PASSWORD=change-me
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FF_JWT_SECRET=change-me-change-me-change-me-change-me

# --- Optional: email for password reset codes -------------------------------------------
# Without FF_SMTP_HOST, reset codes are written to the backend log instead of being emailed.
# For Gmail: host smtp.gmail.com, port 587, your address as the user, and an "app password".
#FF_SMTP_HOST=smtp.gmail.com
#FF_SMTP_PORT=587
#FF_SMTP_USER=you@example.com
#FF_SMTP_PASSWORD=app-password
#FF_SMTP_FROM=FreightFlow <you@example.com>

# --- Optional: a language model for the chatbot -----------------------------------------
# With a key, the model chooses which lookup answers a question; without one, built-in rules do.
# The model is sent the question, city names and the LR number being discussed. It is never
# sent LR records.
#FF_LLM_API_KEY=
#FF_LLM_MODEL=claude-haiku-5-5

# --- Production settings ----------------------------------------------------------------
# production hides the API docs and keeps message contents (reset codes) out of the log.
FF_ENV=production
# The API's address on the server. Keep 0.0.0.0 if the app talks to port 8000 directly today.
# Set 127.0.0.1 once HTTPS (Caddy below or your nginx) is in front, so port 8000 is not public.
FF_API_BIND=0.0.0.0
# true only when the app reaches the API over HTTPS.
FF_HTTPS=false
# Who may set X-Forwarded-For: the reverse proxy. With the bundled Caddy, use * together with
# FF_API_BIND=127.0.0.1 (the proxy is the only thing that can reach the API). Without a proxy: 127.0.0.1.
FF_FORWARDED_ALLOW_IPS=127.0.0.1
# Your DuckDNS name, for the optional bundled HTTPS (docker compose --profile https up -d).
#FF_DOMAIN=your-name.duckdns.org

# --- Sign-up email codes ----------------------------------------------------------------
# A new company's owner confirms their email with a 6-digit code. It switches on by itself
# once SMTP is set above; force it with "required" or "off".
#FF_EMAIL_VERIFICATION=required
# Resend works through its SMTP relay:
#   FF_SMTP_HOST=smtp.resend.com  FF_SMTP_PORT=587  FF_SMTP_USER=resend  FF_SMTP_PASSWORD=<your Resend API key>
#   FF_SMTP_FROM=no-reply@<a domain you verified in Resend>
